{
  "name": "@1call/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "build:android": "eas build -p android",
    "build:ios": "eas build -p ios",
    "web": "expo start --web",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production"
  },
  "dependencies": {
    "@1call/shared": "1.0.0",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-contacts": "~58.0.11",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@testing-library/react-native": "^14.1.0",
    "jest-expo": "~58.0.15"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|socket.io-client|@1call/.*)"
    ]
  }
}
