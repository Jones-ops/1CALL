{
  "expo": {
    "name": "1CALL",
    "slug": "1call",
    "scheme": "onecall",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b3a8f",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "ke.onecall.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "1CALL uses the microphone to record the voice message you broadcast.",
        "NSContactsUsageDescription": "1CALL lets you choose people from your phone contacts to add to a call list."
      }
    },
    "android": {
      "package": "ke.onecall.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b3a8f"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "1CALL uses the microphone to record the voice message you broadcast."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "1CALL lets you choose people from your phone contacts to add to a call list."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0b3a8f",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0b1226"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": {},
      "eas": {
        "projectId": "16671767-dba9-45f1-9c8e-5e6d75634e16"
      }
    },
    "owner": "asibiko",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/16671767-dba9-45f1-9c8e-5e6d75634e16",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
