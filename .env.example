# ---------------------------------------------------------------
# 1CALL configuration. Copy to .env and adjust.
# Secrets live ONLY here (server side) — never in the mobile app.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Public base URL of the API (used for M-Pesa / voice callbacks and signed media URLs).
# Callbacks must be reachable from the internet (e.g. an ngrok URL) when using real providers.
PUBLIC_API_URL=http://localhost:4000
# Browser origins allowed by CORS (the mobile app sends no Origin header).
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 on Render/Railway/behind nginx; 0 if exposed directly).
# Wrong values let clients spoof their IP (bypassing rate limits and the M-Pesa IP allow-list).
TRUST_PROXY=1

# Docker Compose Postgres:  postgresql://onecall:onecall@localhost:5432/onecall
# No Docker? run `npm run db` (embedded Postgres) and use:
DATABASE_URL=postgresql://onecall:onecall@localhost:5433/onecall
# Leave empty to run without Redis: the API then dials in-process (no separate worker needed).
REDIS_URL=redis://localhost:6379

# --- Mock mode (default ON) ------------------------------------
# true  = no real calls and no real M-Pesa charges, whatever is set below.
# false = use VOICE_PROVIDER and MPESA_ENV.
MOCK_MODE=true

# --- Auth -------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
# SMTP for verification / reset emails. Empty = emails are printed to the API console.
SMTP_URL=
MAIL_FROM=1CALL <no-reply@1call.example>

# --- Storage (S3 compatible). Empty S3_BUCKET = local ./uploads + signed /media URLs
S3_BUCKET=onecall-audio
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Host the phone / voice provider can reach for signed URLs (often differs from S3_ENDPOINT in Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_SIGNING_SECRET=change-me-media-secret
MEDIA_URL_TTL_SEC=900
# FFMPEG_PATH=/usr/bin/ffmpeg   # defaults to the bundled ffmpeg-static binary

# --- Voice ------------------------------------------------------
VOICE_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_PHONE_NUMBER=+254711082000
# Configure in the AT dashboard as the voice callback:
#   {PUBLIC_API_URL}/api/v1/webhooks/voice/events?token={VOICE_WEBHOOK_SECRET}
VOICE_WEBHOOK_SECRET=change-me-voice-webhook-secret
GLOBAL_CALL_CONCURRENCY=100
RETRY_DELAY_SEC=1800
RING_TIMEOUT_SEC=180
DIALER_TICK_MS=2000
CALLING_HOURS_START=8
CALLING_HOURS_END=19
VOICE_COST_KES_PER_MIN=2.5
# Mock call pacing
MOCK_CALL_MIN_MS=1500
MOCK_CALL_MAX_MS=4000

# --- M-Pesa Daraja (STK Push) ----------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Secret path segment: callback URL = {PUBLIC_API_URL}/api/v1/webhooks/mpesa/callback/{MPESA_CALLBACK_TOKEN}
MPESA_CALLBACK_TOKEN=change-me-mpesa-callback-token
# Safaricom source IPs are allow-listed automatically in production; override if needed.
MPESA_ALLOWED_IPS=
# MPESA_ENFORCE_IP_ALLOWLIST=true

# --- Mobile app (Expo reads EXPO_PUBLIC_* at build time) -------
# Use your computer's LAN IP so a real phone can reach the API.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
