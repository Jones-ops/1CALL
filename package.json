{
  "name": "1call",
  "version": "1.0.0",
  "private": true,
  "description": "1CALL – One Message. Thousands of Calls. Voice broadcast platform for Kenyan organisations.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db": "npm run db -w @1call/api",
    "dev:api": "npm run dev -w @1call/api",
    "dev:worker": "npm run dev -w @1call/worker",
    "dev:mobile": "npm run start -w @1call/mobile",
    "migrate": "npm run migrate -w @1call/api",
    "seed": "npm run seed -w @1call/api",
    "test": "npm test -w @1call/shared && npm test -w @1call/api && npm test -w @1call/mobile",
    "test:server": "npm test -w @1call/shared && npm test -w @1call/api",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.44.0": true,
    "ffmpeg-static@5.3.0": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@17.6.0-beta.15": true,
    "msgpackr-extract@3.0.7": true,
    "@prisma/engines@6.19.3": true
  }
}
